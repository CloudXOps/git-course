# ──────────────────────────────────────────────
# Git Basics Course — .gitignore
# ──────────────────────────────────────────────

# ── OS generated files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editor / IDE ──
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*.swo
*~
.idea/
*.sublime-project
*.sublime-workspace

# ── Node.js / npm ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
package-lock.json
yarn.lock
pnpm-lock.yaml

# ── Build outputs ──
dist/
build/
out/
.next/
.nuxt/
.cache/
*.min.js
*.min.css

# ── Environment & secrets ──
.env
.env.local
.env.*.local
.env.development
.env.production
*.key
*.pem
secrets.json

# ── Logs ──
logs/
*.log
*.log.*

# ── Test coverage ──
coverage/
.nyc_output/
*.lcov

# ── Temporary files ──
tmp/
temp/
*.tmp
*.bak

# ── Course-specific: student exercise solutions ──
exercises/*/solution/
exercises/*/.student-answers/
